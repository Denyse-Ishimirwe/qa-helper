{
  "manifest_version": 3,
  "name": "QA Helper",
  "version": "1.0",
  "description": "Runs QA Helper test cases against your web forms and reports pass/fail results to your QA Helper project.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "tabs", "storage", "cookies"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://localhost:5173/*",
    "https://citizen-portal.sandbox.iremboinc.com/*",
    "https://keycloak.sandbox.iremboinc.com/*",
    "https://qa-helper-1.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://citizen-portal.sandbox.iremboinc.com/*",
        "https://keycloak.sandbox.iremboinc.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["config.js", "engine-config.js", "content.js"]
    }
  ]
}